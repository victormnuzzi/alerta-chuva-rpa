# Variáveis de ambiente do robô (o código NÃO lê este arquivo; ele só documenta os nomes).
# Defina no terminal antes de rodar, ou como Secrets do repositório no GitHub Actions.
# PowerShell:  $env:RPA_HASH_SALT = "valor-longo-e-aleatorio"
# Bash:        export RPA_HASH_SALT="valor-longo-e-aleatorio"

# Sal usado no hash SHA-256 dos e-mails.
RPA_HASH_SALT=troque-por-um-valor-aleatorio
# Opcional: tópico público do ntfy.sh para receber o aviso no celular (sem dados pessoais).
NTFY_TOPIC=
