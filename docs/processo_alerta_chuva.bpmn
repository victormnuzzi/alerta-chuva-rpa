<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definicoes_AlertaChuva" targetNamespace="http://bpmn.io/schema/bpmn" exporter="manual" exporterVersion="1.0">
<bpmn:process id="Processo_AlertaChuva" name="Robô Alerta Chuva SP" isExecutable="false">
<bpmn:startEvent id="Inicio" name="A cada hora"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle>R/PT1H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="T_Config" name="Carregar configuração (municípios e regras)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Config" name="Configuração válida?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fim_Fatal" name="Falha fatal (código 2)"><bpmn:incoming>F4</bpmn:incoming><bpmn:errorEventDefinition /></bpmn:endEvent>
<bpmn:serviceTask id="T_Inscricoes" name="Ler e validar inscrições (rejeita inválidas e duplicadas; mascara dados)"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:subProcess id="SP_Municipio" name="Processar cada município (12)"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /><bpmn:startEvent id="S_Inicio" name="Município"><bpmn:outgoing>S1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="S_Coletar" name="Coletar previsão 24 h na Open-Meteo (3 tentativas, backoff)"><bpmn:incoming>S1</bpmn:incoming><bpmn:outgoing>S2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="S_G_Valido" name="Dados válidos?"><bpmn:incoming>S2</bpmn:incoming><bpmn:outgoing>S3</bpmn:outgoing><bpmn:outgoing>S7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="S_Classificar" name="Classificar nível (acumulado 24 h + pico 1 h)"><bpmn:incoming>S3</bpmn:incoming><bpmn:incoming>S9</bpmn:incoming><bpmn:outgoing>S4</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="S_G_Forte" name="Forte ou Muito forte?"><bpmn:incoming>S4</bpmn:incoming><bpmn:outgoing>S5</bpmn:outgoing><bpmn:outgoing>S12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="S_Notificar" name="Notificar inscritos ainda não avisados"><bpmn:incoming>S5</bpmn:incoming><bpmn:outgoing>S6</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="S_Fim_Ok" name="Alerta enviado"><bpmn:incoming>S6</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="S_G_Cache" name="Cache com menos de 6 h?"><bpmn:incoming>S7</bpmn:incoming><bpmn:outgoing>S8</bpmn:outgoing><bpmn:outgoing>S10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S_Cache" name="Usar previsão do cache"><bpmn:incoming>S8</bpmn:incoming><bpmn:outgoing>S9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="S_SemDados" name="Registrar erro e marcar 'Sem dados'"><bpmn:incoming>S10</bpmn:incoming><bpmn:outgoing>S11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="S_Fim_SemDados" name="Município sem dados"><bpmn:incoming>S11</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="S_Fim_SemAlerta" name="Sem alerta"><bpmn:incoming>S12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="S1" sourceRef="S_Inicio" targetRef="S_Coletar" />
<bpmn:sequenceFlow id="S2" sourceRef="S_Coletar" targetRef="S_G_Valido" />
<bpmn:sequenceFlow id="S3" name="Sim" sourceRef="S_G_Valido" targetRef="S_Classificar" />
<bpmn:sequenceFlow id="S4" sourceRef="S_Classificar" targetRef="S_G_Forte" />
<bpmn:sequenceFlow id="S5" name="Sim" sourceRef="S_G_Forte" targetRef="S_Notificar" />
<bpmn:sequenceFlow id="S6" sourceRef="S_Notificar" targetRef="S_Fim_Ok" />
<bpmn:sequenceFlow id="S7" name="Não / API fora" sourceRef="S_G_Valido" targetRef="S_G_Cache" />
<bpmn:sequenceFlow id="S8" name="Sim" sourceRef="S_G_Cache" targetRef="S_Cache" />
<bpmn:sequenceFlow id="S9" sourceRef="S_Cache" targetRef="S_Classificar" />
<bpmn:sequenceFlow id="S10" name="Não" sourceRef="S_G_Cache" targetRef="S_SemDados" />
<bpmn:sequenceFlow id="S11" sourceRef="S_SemDados" targetRef="S_Fim_SemDados" />
<bpmn:sequenceFlow id="S12" name="Não" sourceRef="S_G_Forte" targetRef="S_Fim_SemAlerta" /></bpmn:subProcess>
<bpmn:serviceTask id="T_Painel" name="Publicar painel_alertas.json para o MVP"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_Auditoria" name="Registrar resumo de auditoria (execucoes.csv)"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Erros" name="Houve erros?"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Fim_Sucesso" name="Sucesso (código 0)"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="Fim_Parcial" name="Parcial: erros registrados (código 1)"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="T_Config" />
<bpmn:sequenceFlow id="F2" sourceRef="T_Config" targetRef="G_Config" />
<bpmn:sequenceFlow id="F3" name="Sim" sourceRef="G_Config" targetRef="T_Inscricoes" />
<bpmn:sequenceFlow id="F4" name="Não" sourceRef="G_Config" targetRef="Fim_Fatal" />
<bpmn:sequenceFlow id="F5" sourceRef="T_Inscricoes" targetRef="SP_Municipio" />
<bpmn:sequenceFlow id="F6" sourceRef="SP_Municipio" targetRef="T_Painel" />
<bpmn:sequenceFlow id="F7" sourceRef="T_Painel" targetRef="T_Auditoria" />
<bpmn:sequenceFlow id="F8" sourceRef="T_Auditoria" targetRef="G_Erros" />
<bpmn:sequenceFlow id="F9" name="Não" sourceRef="G_Erros" targetRef="Fim_Sucesso" />
<bpmn:sequenceFlow id="F10" name="Sim" sourceRef="G_Erros" targetRef="Fim_Parcial" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagrama"><bpmndi:BPMNPlane id="Plano" bpmnElement="Processo_AlertaChuva">
<bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="60" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="30" y="322" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_Config_di" bpmnElement="T_Config"><dc:Bounds x="140" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G_Config_di" bpmnElement="G_Config" isMarkerVisible="true"><dc:Bounds x="310" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="285" y="243" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Fim_Fatal_di" bpmnElement="Fim_Fatal"><dc:Bounds x="317" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="287" y="442" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_Inscricoes_di" bpmnElement="T_Inscricoes"><dc:Bounds x="410" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="SP_Municipio_di" bpmnElement="SP_Municipio" isExpanded="true"><dc:Bounds x="580" y="180" width="870" height="330" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_Painel_di" bpmnElement="T_Painel"><dc:Bounds x="1500" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_Auditoria_di" bpmnElement="T_Auditoria"><dc:Bounds x="1670" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G_Erros_di" bpmnElement="G_Erros" isMarkerVisible="true"><dc:Bounds x="1840" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1815" y="243" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Fim_Sucesso_di" bpmnElement="Fim_Sucesso"><dc:Bounds x="1950" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1920" y="322" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Fim_Parcial_di" bpmnElement="Fim_Parcial"><dc:Bounds x="1847" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1817" y="442" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Inicio_di" bpmnElement="S_Inicio"><dc:Bounds x="610" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="580" y="322" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Coletar_di" bpmnElement="S_Coletar"><dc:Bounds x="680" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_G_Valido_di" bpmnElement="S_G_Valido" isMarkerVisible="true"><dc:Bounds x="850" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="825" y="243" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Classificar_di" bpmnElement="S_Classificar"><dc:Bounds x="950" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_G_Forte_di" bpmnElement="S_G_Forte" isMarkerVisible="true"><dc:Bounds x="1120" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1095" y="243" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Notificar_di" bpmnElement="S_Notificar"><dc:Bounds x="1220" y="260" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Fim_Ok_di" bpmnElement="S_Fim_Ok"><dc:Bounds x="1390" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1360" y="322" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_G_Cache_di" bpmnElement="S_G_Cache" isMarkerVisible="true"><dc:Bounds x="850" y="425" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="825" y="479" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Cache_di" bpmnElement="S_Cache"><dc:Bounds x="950" y="410" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_SemDados_di" bpmnElement="S_SemDados"><dc:Bounds x="680" y="410" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Fim_SemDados_di" bpmnElement="S_Fim_SemDados"><dc:Bounds x="610" y="432" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="580" y="472" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Fim_SemAlerta_di" bpmnElement="S_Fim_SemAlerta"><dc:Bounds x="1127" y="432" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1097" y="472" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="96" y="300" /><di:waypoint x="140" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="260" y="300" /><di:waypoint x="310" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="360" y="300" /><di:waypoint x="410" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="389" y="286" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="335" y="325" /><di:waypoint x="335" y="402" /><bpmndi:BPMNLabel><dc:Bounds x="339" y="350" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="530" y="300" /><di:waypoint x="580" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1450" y="300" /><di:waypoint x="1500" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1620" y="300" /><di:waypoint x="1670" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1790" y="300" /><di:waypoint x="1840" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1890" y="300" /><di:waypoint x="1950" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="1924" y="286" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1865" y="325" /><di:waypoint x="1865" y="402" /><bpmndi:BPMNLabel><dc:Bounds x="1869" y="350" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
